# ============================================================
# ChainMind AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file
# ============================================================

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///./chainmind.db

# Application
APP_ENV=development
DEBUG=true

# CORS — production Vercel frontend URL(s), comma-separated.
# Localhost is always allowed automatically. Only set this in production.
# Example: CORS_ORIGINS=https://chainmind-ai.vercel.app
CORS_ORIGINS=

# ─── LLM Configuration (optional — app works without these) ─────────────────
# Set LLM_PROVIDER to: openai | watsonx | none
LLM_PROVIDER=none

# For OpenAI:
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# For IBM watsonx.ai:
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── ML Models ───────────────────────────────────────────────────────────────
ML_MODELS_DIR=ml_models

# ─── Risk score weights (must sum to 1.0) ────────────────────────────────────
WEIGHT_DELAY=0.25
WEIGHT_CARGO_VALUE=0.20
WEIGHT_COLD_CHAIN=0.20
WEIGHT_ROUTE_RISK=0.15
WEIGHT_PRIORITY=0.15
WEIGHT_FLEET_AVAIL=0.05
